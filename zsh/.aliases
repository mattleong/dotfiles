# neovim
rebuild-nvim() {
  brew unlink neovim
  brew install --build-from-source --HEAD --force --fetch-HEAD neovim
}

rebuild-nvim-head() {
  brew unlink neovim
  brew install --HEAD neovim
}

rebuild-nvim-main() {
  brew unlink neovim
  brew install neovim
}

alias v='echo "Set nvim alias in .aliases.local"'

# Git shit
gl() { git log --oneline -"${1:-25}" }

alias gs='git status -sb'
alias ga='git add -A'
alias gd='git diff'
alias gds='git diff --stat'
alias gca='git commit --amend'
alias gcan='git commit --amend --no-edit'
alias glg='git log --graph --abbrev-commit --decorate --format=format:"%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)" --all'

gc() {
	git commit -m "$*"
}

# Generate a commit message from the staged diff with codex, then commit.
# Extra args go to git commit (e.g. `gcm -e` to edit the message first).
gcm() {
	emulate -L zsh
	setopt localoptions no_monitor no_notify

	if git diff --cached --no-ext-diff --no-textconv --quiet; then
		echo "No staged changes. Use 'ga' (or git add) first."
		return 1
	fi

	local msg_file spinner_pid attempt
	msg_file="$(mktemp -t codex-commit-msg.XXXXXX)" || return 1

	# Hard 25s timeout when coreutils is installed; otherwise Ctrl-C works.
	local -a timeout_cmd
	if (( $+commands[gtimeout] )); then
		timeout_cmd=(gtimeout -k 2 25)
	elif (( $+commands[timeout] )); then
		timeout_cmd=(timeout -k 2 25)
	fi

	{
		if [[ -t 2 && "${TERM:-dumb}" != "dumb" ]]; then
			(
				local -a frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
				local i=1
				while :; do
					printf '\r\033[2;36m%s Generating commit message\033[0m' "${frames[i]}" >&2
					i=$(( i % $#frames + 1 ))
					sleep 0.1
				done
			) &
			spinner_pid=$!
		fi

		for attempt in 1 2; do
			: >| "$msg_file"
			{
				cat <<'EOF'
Write a git commit message from the staged diff content below.
Use only the provided content as input.
Do not run tools or shell commands.
Use Conventional Commits format.
Output only the final commit message text (no markdown, no code fences, no explanation).
Keep the subject line <= 72 characters.
Body's lines must not be longer than 100 characters.
Include a short body only when needed.

Full staged diff:
EOF
				git diff --cached --no-ext-diff --no-textconv --no-color
			} | "${timeout_cmd[@]}" codex exec \
				-m gpt-6-luna \
				--enable fast_mode \
				-c 'service_tier="fast"' \
				-c 'model_reasoning_effort="medium"' \
				--sandbox read-only \
				--ephemeral \
				--skip-git-repo-check \
				--color never \
				--output-last-message "$msg_file" \
				- >/dev/null 2>&1
			[[ -s "$msg_file" ]] && break
		done

		if [[ -n "$spinner_pid" ]]; then
			kill "$spinner_pid" 2>/dev/null
			printf '\r\033[2K' >&2
			spinner_pid=""
		fi

		if [[ ! -s "$msg_file" ]]; then
			echo "Failed to generate a commit message. Try again or run gc \"message\"."
			return 1
		fi

		git commit -F "$msg_file" "$@"
	} always {
		[[ -n "$spinner_pid" ]] && kill "$spinner_pid" 2>/dev/null && printf '\r\033[2K' >&2
		rm -f -- "$msg_file"
	}
}

unalias yeet 2>/dev/null
yeet() {
	git add -A && gcm && git push
}

# mcd: Makes new directory and jumps into it
mcd () { mkdir -p "$1" && cd "$1"; }

alias cd..='cd ../'                         # Go back 1 directory
# level (for fast typers)
alias ..='cd ../'                           # Go back 1 directory level
alias ...='cd ../../'                       # Go back 2 directory levels
alias .3='cd ../../../'                     # Go back 3 directory levels
alias .4='cd ../../../../'                  # Go back 4 directory levels
alias .5='cd ../../../../../'               # Go back 5 directory levels
alias .6='cd ../../../../../../'            # Go back 6 directory levels

alias edit-claude='$EDITOR ~/.claude/settings.json'
alias edit-codex='$EDITOR ~/.codex/config.toml'
alias edit-opencode='$EDITOR ~/.config/opencode/opencode.jsonc'

alias c="codex --yolo"
alias cl="claude --allow-dangerously-skip-permissions"
